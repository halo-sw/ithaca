{
  "version": "0.1",
  "description": "Ground-truth checklists for the 30-day housing simulator. The agent's proposed checklist is compared against these; it passes when all 'must' items are covered AND weighted coverage >= threshold.",
  "acceptance": {
    "must_coverage": 1.0,
    "weighted_coverage_threshold": 0.8,
    "weights": {
      "must": 3,
      "should": 1
    },
    "max_retries": 3,
    "on_fail_after_retries": "escalate_to_user"
  },
  "verification_types": {
    "deterministic": "Value is computed from listing/map/route data in code; the report's number must match the computed value (no invented numbers).",
    "judge": "LLM-as-a-judge checks that the claim cites at least one simulation log event (event_id) that supports it."
  },
  "common_items": [
    {
      "id": "C01",
      "priority": "must",
      "verify": "deterministic",
      "label_ko": "주 통근·통학 시간",
      "label_en": "Main commute / school travel time",
      "data_field": "route.commute_minutes",
      "rule": "report value within ±5 min of computed value",
      "keywords": [
        "통근",
        "출퇴근",
        "통학",
        "commute"
      ],
      "engine": "supported",
      "engine_source": "commute trips (purpose=commute)"
    },
    {
      "id": "C02",
      "priority": "must",
      "verify": "deterministic",
      "label_ko": "월 주거비 총액 (월세 또는 대출 상환·관리비·공과금)",
      "label_en": "Total monthly housing cost",
      "data_field": "listing.monthly_total",
      "rule": "report value equals rent + maintenance + estimated utilities",
      "keywords": [
        "월세",
        "관리비",
        "주거비",
        "공과금",
        "rent",
        "cost"
      ],
      "engine": "partial",
      "engine_source": "jeonse money timeline; monthly rent/maintenance only when the listing has them"
    },
    {
      "id": "C03",
      "priority": "must",
      "verify": "judge",
      "label_ko": "소음 (층간·도로·상가)",
      "label_en": "Noise (neighbors, traffic, commercial)",
      "evidence_events": [
        "noise"
      ],
      "keywords": [
        "소음",
        "층간",
        "시끄",
        "noise"
      ],
      "engine": "none",
      "engine_source": "no event kind: noise"
    },
    {
      "id": "C04",
      "priority": "should",
      "verify": "deterministic",
      "label_ko": "채광·향",
      "label_en": "Daylight / orientation",
      "data_field": "listing.orientation",
      "rule": "orientation stated matches listing data",
      "keywords": [
        "채광",
        "햇빛",
        "남향",
        "향",
        "daylight",
        "sunlight"
      ],
      "engine": "none",
      "engine_source": "no listing field: orientation"
    },
    {
      "id": "C05",
      "priority": "should",
      "verify": "deterministic",
      "label_ko": "생필품 접근성 (마트·편의점 도보 거리)",
      "label_en": "Grocery / convenience store access",
      "data_field": "poi.grocery_walk_minutes",
      "rule": "report value within ±2 min of computed value",
      "keywords": [
        "마트",
        "편의점",
        "장보기",
        "grocery"
      ],
      "engine": "supported",
      "engine_source": "errand trips (purpose=errand)"
    },
    {
      "id": "C06",
      "priority": "should",
      "verify": "judge",
      "label_ko": "야간 귀갓길 안전",
      "label_en": "Night-time walk-home safety",
      "evidence_events": [
        "dark_walk",
        "late_home"
      ],
      "keywords": [
        "귀갓길",
        "야간",
        "밤길",
        "가로등",
        "safety",
        "night"
      ],
      "engine": "supported",
      "engine_source": "life-events: household commute trips arriving home after sunset (dark_walk) and trips arriving home at/after 22:00 (late_home); evidence = trip ids"
    },
    {
      "id": "C07",
      "priority": "should",
      "verify": "judge",
      "label_ko": "수납·짐 배치",
      "label_en": "Storage / furniture fit",
